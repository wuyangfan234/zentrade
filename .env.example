# ZenTrade 配置示例。复制为 .env 并 chmod 600。
# 所有 key 也可以在页面「设置」里填写（写入 data/user_data/secrets.json，优先于本文件）。
# 每项的用途、不配的影响见页面「设置 → 数据源」顶部的「配置清单」，或 docs/configuration.md。

# ===== 必需：Alpaca 美股行情（免费账户即可 https://app.alpaca.markets/signup）=====
# 日K / 分钟K / 交易日历 / 公司行动 / 纸面镜像都依赖它。
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ===== 建议：新闻与基本面 =====
# Finnhub 免费档：个股新闻、财报日期核对、财务兜底、公司图标
FINNHUB_API_KEY=
# SEC EDGAR 要求请求头带联系邮箱，例如：ZenTrade you@example.com
SEC_USER_AGENT=

# ===== 可选：增强数据源 =====
# TickFlow 盘中实时（全市场合并口径）；不填则用 Alpaca IEX
TICKFLOW_API_KEY=
# QVeris 期权 / 财报预期 / 电话会（按积分计费）
QVERIS_API_KEY=

# ===== 建议：AI 模型（OpenAI 兼容接口）=====
# 用于个股分析、新闻翻译与打标、AI 策略生成。不填则这些功能不可用，交易环不受影响。
# 新闻翻译用量大（约 600 条/交易日），建议在设置页「AI 模型分工」给它单独配低价、关思考的模型。
AI_PROVIDER=openai_compat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ===== 可选：飞书应用机器人推送（也可在设置页配置群 Webhook / 企业微信 / 邮件）=====
ZENTRADE_FEISHU_APP_ID=
ZENTRADE_FEISHU_APP_SECRET=

# ===== 服务 =====
# 监听地址。Docker 下决定宿主机端口绑定: 127.0.0.1 = 只允许本机访问 (默认, 最安全);
# 0.0.0.0 = 局域网可访问。公网访问请放在 HTTPS 反向代理或受信隧道之后, 不要直接暴露端口。
HOST=127.0.0.1
PORT=3018
LOG_LEVEL=INFO

# 跨域来源白名单 (逗号分隔)。留空 = 只允许同源, 前端由本服务托管时无需配置。
CORS_ALLOW_ORIGINS=
# 登录 Cookie 的 Secure 标志: auto (按 HTTPS / 可信反代的 X-Forwarded-Proto 自动判断) | true | false
COOKIE_SECURE=auto

# 新闻翻译兜底: AI 打标失败时改用 Google 翻译网页端点 (非官方、无 SLA) 只翻译标题。默认关闭。
NEWS_GOOGLE_TRANSLATE_FALLBACK=0

# ===== 访问密码 =====
# 首次启动时预置访问密码；仅在尚未设置密码时生效，之后在页面修改。公网部署必填，建议 12 位以上。
AUTH_PASSWORD=''

# ===== Docker 构建 =====
# 可选后端依赖: legacy-cpu (老 CPU 无 AVX2) / backtest (vectorbt, Apache-2.0 + Commons Clause, 含销售限制)
BACKEND_EXTRAS=
# 中国大陆网络构建可设为 1, 改用国内 npm / PyPI / Debian 镜像
USE_CN_MIRROR=0

# ===== 数据目录 =====
DATA_DIR=./data
