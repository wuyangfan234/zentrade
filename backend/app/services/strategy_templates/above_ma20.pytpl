"""站上均线: 收盘价在 MA20 上方, 且 20 日动量为正。"""
import polars as pl

META = {
    "id": "custom_above_ma20",
    "name": "站上 MA20",
    "description": "收盘价在 MA20 上方, 且 20 日动量不低于阈值。",
    "tags": ["趋势", "入门"],
    "asset_types": ["stock"],
    "timeframes": ["1d"],
    "basic_filter": {"price_min": 5, "price_max": None, "amount_min": 2e7},
    "params": [
        {"id": "min_momentum", "label": "20 日最小涨幅", "type": "float",
         "default": 0.0, "min": -0.2, "max": 0.5, "step": 0.01},
    ],
    "scoring": {"momentum_20d": 1.0},
    "order_by": "score",
    "descending": True,
    "limit": 100,
}

EXECUTION_BACKEND = "polars_expr"
ENTRY_SIGNALS = []
EXIT_SIGNALS = []
STOP_LOSS = -0.06
MAX_HOLD_DAYS = 10

RULES = """
1. 收盘价在 MA20 上方。
2. 20 日动量不低于参数阈值。
"""


def filter(df: pl.DataFrame, params: dict) -> pl.Expr:
    min_momentum = float(params.get("min_momentum", 0.0))
    return (
        (pl.col("close") > pl.col("ma20"))
        & (pl.col("momentum_20d") >= min_momentum)
    ).fill_null(False)
